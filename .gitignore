# ----------------------
# 1. Dependencies (Thư viện)
# ----------------------
node_modules/
package-lock.json # (Tuỳ chọn: Thường thì nên giữ file này, nhưng nếu team dùng yarn thì bỏ)
yarn.lock         # (Giữ lại nếu dùng yarn)

# ----------------------
# 2. Environment Variables (BẢO MẬT - QUAN TRỌNG NHẤT)
# ----------------------
.env
.env.test
.env.production
.env.local

# ----------------------
# 3. Logs (File nhật ký lỗi)
# ----------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----------------------
# 4. OS System Files (File rác hệ điều hành)
# ----------------------
.DS_Store         # Mac
Thumbs.db         # Windows
Desktop.ini       # Windows

# ----------------------
# 5. IDE / Editor configs (Cấu hình riêng của máy dev)
# ----------------------
.idea/            # WebStorm / IntelliJ
.vscode/          # VS Code (User settings)
*.swp             # Vim
*.swo

# ----------------------
# 6. Testing & Coverage (Khi chạy test sau này)
# ----------------------
coverage/
.nyc_output/

# ----------------------
# 7. Build Output (Nếu sau này dùng TypeScript/Babel)
# ----------------------
dist/
build/

# ----------------------
# 8. Temporary files
# ----------------------
tmp/
temp/